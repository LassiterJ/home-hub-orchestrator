{
   "name": "@home-hub-orchestrator/server",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "scripts": {
      "start": "cross-env NODE_ENV=production node dist/src/server.js",
      "pm2:start": "pnpm pm2:delete && pnpm build && cross-env NODE_ENV=test pm2 start dist/src/server.js --name @home-hub-orchestrator/server",
      "pm2:delete": "pm2 delete all &",
      "pm2:logs": "pm2 logs",
      "dev": "nodemon --exec tsx src/server.ts --inspect",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "ts:check": "tsx -b",
      "check": "pnpm lint && pnpm ts:check",
      "build": "tsc -b",
      "test:unit": "vitest .unit.test.ts",
      "test:unit:run": "pnpm test:unit --run",
      "test:integration": "vitest .integration.test.ts",
      "test:integration:run": "pnpm test:integration --run",
      "test:e2e": "vitest .e2e.test.ts",
      "test:e2e:run": "pnpm test:e2e --run",
      "test:coverage": "pnpm pm2:start && vitest run --coverage && pnpm pm2:delete",
      "test:coverage:preview": "pnpm test:coverage && vite preview --outDir ./coverage --open"
   },
   "dependencies": {
      "@trpc/client": "^11.4.4",
      "@trpc/server": "^11.4.4",
      "@trpc/tanstack-react-query": "^11.4.4",
      "@types/cors": "^2.8.19",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "express": "^5.1.0",
      "express-serve-static-core": "^0.1.1",
      "zod": "^4.0.17"
   },
   "devDependencies": {
      "@home-hub-orchestrator/config": "workspace:*",
      "@home-hub-orchestrator/tsconfig": "workspace:*",
      "@swc/core": "^1.3.62",
      "@trivago/prettier-plugin-sort-imports": "^4.2.0",
      "@types/cookie-parser": "^1.4.3",
      "@types/express": "^4.17.17",
      "@types/module-alias": "^2.0.1",
      "@types/node": "^18.16.17",
      "@vitest/coverage-istanbul": "^0.34.1",
      "cross-env": "^7.0.3",
      "dotenv": "^17.2.1",
      "envalid": "^8.1.0",
      "module-alias": "^2.2.3",
      "nodemon": "^3.1.10",
      "pm2": "^6.0.8",
      "tsx": "^4.20.4",
      "typescript": "^5.0.0"
   }
}
